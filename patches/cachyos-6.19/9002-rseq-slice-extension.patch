+static __always_inline bool is_rseq_lightweight_syscall(long syscall)
+{
+	switch (syscall) {
+	case 14:	/* __NR_rt_sigprocmask - just modifies signal mask */
+	case 98:	/* __NR_getrusage - just reads counters */
+	case 39:	/* __NR_getpid - trivial, cached value */
+	case 186:	/* __NR_gettid - trivial, cached value */
+	case 228:	/* __NR_clock_gettime - fast time read */
+	case 96:	/* __NR_gettimeofday - fast time read */
+	case 24:	/* __NR_sched_yield - cooperative yield, preserve grant */
+		return true;
+	default:
+		return false;
