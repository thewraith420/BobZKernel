From: Bob <bob@bobzkernel.local>
Subject: [PATCH] RSEQ timeslice extension fixes for Debian/glibc 2.41

This patch fixes issues with the RSEQ timeslice extension backport
when building on Debian 13 with glibc 2.41 and newer kernel baselines.

The main RSEQ patch (0002) expects an older kernel baseline, but
upstream kernel changes (mm_cid field addition, flags comment updates)
cause the patch to not apply cleanly to include/uapi/linux/rseq.h.

Additionally, include/linux/rseq_entry.h may not get the full
rseq_grant_slice_extension() function implementation if the patch
context doesn't match.

This supplemental patch ensures these critical files have the
correct content regardless of baseline changes.

Fixes:
- Missing rseq_grant_slice_extension() implementation in rseq_entry.h
- Missing RSEQ_CS_FLAG_SLICE_EXT_* flags in uapi/rseq.h
- Missing struct rseq_slice_ctrl definition
- Missing slice_ctrl field in struct rseq

diff --git a/include/linux/rseq_entry.h b/include/linux/rseq_entry.h
index d99c40448f1b..531ca6acf973 100644
--- a/include/linux/rseq_entry.h
+++ b/include/linux/rseq_entry.h
@@ -10,20 +10,94 @@

 #ifdef CONFIG_RSEQ
 #include <linux/jump_label.h>
+#include <linux/uaccess.h>
+#include <linux/sched/signal.h>

 #ifdef CONFIG_RSEQ_SLICE_EXTENSION
+
+extern unsigned int rseq_slice_ext_nsecs;
+
 DECLARE_STATIC_KEY_TRUE(rseq_slice_extension_key);

 static __always_inline bool rseq_slice_extension_enabled(void)
 {
 	return static_branch_likely(&rseq_slice_extension_key);
 }
+
+/*
+ * Grant a time slice extension to the current task.
+ * Called from the exit-to-usermode path when need_resched is set.
+ *
+ * Simplified 6.18 version without event tracking and scoped guards.
+ */
+static __always_inline bool rseq_grant_slice_extension(bool work_pending)
+{
+	struct task_struct *curr = current;
+	struct rseq_slice_ctrl usr_ctrl;
+	struct rseq __user *rseq;
+	unsigned long flags;
+
+	if (!rseq_slice_extension_enabled())
+		return false;
+
+	/* If not enabled for this task, nothing to do */
+	if (likely(!curr->rseq_slice.state.enabled))  /* Adapted for 6.18 */
+		return false;
+
+	/* If already granted or other work pending, revoke/deny */
+	if (unlikely(work_pending || curr->rseq_slice.state.granted)) {  /* Adapted for 6.18 */
+		/* Clear user control and kernel state */
+		rseq = curr->rseq;  /* Adapted for 6.18 */
+		if (put_user(0U, &rseq->slice_ctrl.all))
+			goto efault;
+		curr->rseq_slice.state.granted = 0;  /* Adapted for 6.18 */
+		return false;
+	}
+
+	rseq = curr->rseq;  /* Adapted for 6.18 */
+
+	/* Check if user requested an extension */
+	if (get_user(usr_ctrl.all, &rseq->slice_ctrl.all))
+		goto efault;
+
+	if (likely(!usr_ctrl.request))
+		return false;
+
+	/* Grant the slice extension */
+	usr_ctrl.request = 0;
+	usr_ctrl.granted = 1;
+	if (put_user(usr_ctrl.all, &rseq->slice_ctrl.all))
+		goto efault;
+
+	curr->rseq_slice.state.granted = 1;  /* Adapted for 6.18 */
+
+	/* Store expiry time for arming the timer */
+	curr->rseq_slice.expires = rseq_slice_ext_nsecs + ktime_get_mono_fast_ns();  /* Adapted for 6.18 */
+
+	/*
+	 * Clear need_resched with interrupts disabled to avoid races.
+	 * 6.18 uses traditional irq save/restore instead of scoped_guard(irq).
+	 */
+	local_irq_save(flags);
+	clear_tsk_need_resched(curr);
+	clear_preempt_need_resched();
+	local_irq_restore(flags);
+
+	return true;
+
+efault:
+	force_sig(SIGSEGV);
+	return false;
+}
+
 #else /* CONFIG_RSEQ_SLICE_EXTENSION */
 static inline bool rseq_slice_extension_enabled(void) { return false; }
+static inline bool rseq_grant_slice_extension(bool work_pending) { return false; }
 #endif /* !CONFIG_RSEQ_SLICE_EXTENSION */

 #else /* CONFIG_RSEQ */
 static inline bool rseq_slice_extension_enabled(void) { return false; }
+static inline bool rseq_grant_slice_extension(bool work_pending) { return false; }
 #endif /* !CONFIG_RSEQ */

 #endif /* _LINUX_RSEQ_ENTRY_H */
diff --git a/include/uapi/linux/rseq.h b/include/uapi/linux/rseq.h
index c233aae5eac9..6afc219d1545 100644
--- a/include/uapi/linux/rseq.h
+++ b/include/uapi/linux/rseq.h
@@ -23,9 +23,15 @@ enum rseq_flags {
 };

 enum rseq_cs_flags_bit {
+	/* Historical and unsupported bits */
 	RSEQ_CS_FLAG_NO_RESTART_ON_PREEMPT_BIT	= 0,
 	RSEQ_CS_FLAG_NO_RESTART_ON_SIGNAL_BIT	= 1,
 	RSEQ_CS_FLAG_NO_RESTART_ON_MIGRATE_BIT	= 2,
+	/* (3) Intentional gap to put new bits into a separate byte */
+
+	/* User read only feature flags */
+	RSEQ_CS_FLAG_SLICE_EXT_AVAILABLE_BIT	= 4,
+	RSEQ_CS_FLAG_SLICE_EXT_ENABLED_BIT	= 5,
 };

 enum rseq_cs_flags {
@@ -35,6 +41,11 @@ enum rseq_cs_flags {
 		(1U << RSEQ_CS_FLAG_NO_RESTART_ON_SIGNAL_BIT),
 	RSEQ_CS_FLAG_NO_RESTART_ON_MIGRATE	=
 		(1U << RSEQ_CS_FLAG_NO_RESTART_ON_MIGRATE_BIT),
+
+	RSEQ_CS_FLAG_SLICE_EXT_AVAILABLE	=
+		(1U << RSEQ_CS_FLAG_SLICE_EXT_AVAILABLE_BIT),
+	RSEQ_CS_FLAG_SLICE_EXT_ENABLED		=
+		(1U << RSEQ_CS_FLAG_SLICE_EXT_ENABLED_BIT),
 };

 /*
@@ -53,6 +64,27 @@ struct rseq_cs {
 	__u64 abort_ip;
 } __attribute__((aligned(4 * sizeof(__u64))));

+/**
+ * rseq_slice_ctrl - Time slice extension control structure
+ * @all:	Compound value
+ * @request:	Request for a time slice extension
+ * @granted:	Granted time slice extension
+ *
+ * @request is set by user space and can be cleared by user space or kernel
+ * space.  @granted is set and cleared by the kernel and must only be read
+ * by user space.
+ */
+struct rseq_slice_ctrl {
+	union {
+		__u32		all;
+		struct {
+			__u8	request;
+			__u8	granted;
+			__u16	__reserved;
+		};
+	};
+};
+
 /*
  * struct rseq is aligned on 4 * 8 bytes to ensure it is always
  * contained within a single cache-line.
@@ -114,20 +146,13 @@ struct rseq {
 	/*
 	 * Restartable sequences flags field.
 	 *
-	 * This field should only be updated by the thread which
-	 * registered this data structure. Read by the kernel.
-	 * Mainly used for single-stepping through rseq critical sections
-	 * with debuggers.
-	 *
-	 * - RSEQ_CS_FLAG_NO_RESTART_ON_PREEMPT
-	 *     Inhibit instruction sequence block restart on preemption
-	 *     for this thread.
-	 * - RSEQ_CS_FLAG_NO_RESTART_ON_SIGNAL
-	 *     Inhibit instruction sequence block restart on signal
-	 *     delivery for this thread.
-	 * - RSEQ_CS_FLAG_NO_RESTART_ON_MIGRATE
-	 *     Inhibit instruction sequence block restart on migration for
-	 *     this thread.
+	 * This field was initially intended to allow event masking for
+	 * single-stepping through rseq critical sections with debuggers.
+	 * The kernel does not support this anymore and the relevant bits
+	 * are checked for being always false:
+	 *	- RSEQ_CS_FLAG_NO_RESTART_ON_PREEMPT
+	 *	- RSEQ_CS_FLAG_NO_RESTART_ON_SIGNAL
+	 *	- RSEQ_CS_FLAG_NO_RESTART_ON_MIGRATE
 	 */
 	__u32 flags;

@@ -148,6 +173,12 @@ struct rseq {
 	 */
 	__u32 mm_cid;

+	/*
+	 * Time slice extension control structure. CPU local updates from
+	 * kernel and user space.
+	 */
+	struct rseq_slice_ctrl slice_ctrl;
+
 	/*
 	 * Flexible array member at end of structure, after last feature field.
 	 */
