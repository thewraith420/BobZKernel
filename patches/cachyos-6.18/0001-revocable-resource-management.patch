+==========================
+Revocable Resource Management
+==========================
+
+Overview
+========
+
+Revocable provides a mechanism for managing resources that can be asynchronously
+removed, such as those from hot-pluggable devices (USB, PCIe, etc.). It prevents
+use-after-free errors by enabling safe access patterns when device removal may
+occur at any time.
+
+Unlike device-managed (devm) resources that are tied to device lifetime, revocable
+resources persist as long as consumers hold references to them, allowing safe
+access attempts even after the underlying device has been removed.
+
+Design
+======
+
+The revocable system uses a provider/consumer model built on Sleepable RCU (SRCU):
+
+**Providers** own resources and can revoke access at any time by calling
+``revocable_provider_revoke()``. This sets the resource pointer to NULL and
+synchronizes with SRCU to ensure all active readers have finished.
+
+**Consumers** attempt to access a provider's resource by calling
+``revocable_try_access()``. This returns either the resource pointer (if valid)
+or NULL (if revoked), and the caller is guaranteed safe access for the duration
+of the critical section.
+
+Usage Example
+=============
+
+Provider Side
+-------------
+
+::
+
+    struct my_device {
+        struct revocable_provider *provider;
+        struct resource *res;
+    };
+
+    static int my_device_probe(struct platform_device *pdev)
+    {
+        struct my_device *dev;
+
+        dev = devm_kzalloc(&pdev->dev, sizeof(*dev), GFP_KERNEL);
+        if (!dev)
+            return -ENOMEM;
+
+        dev->res = devm_request_resource(...);
+        dev->provider = devm_revocable_provider_alloc(&pdev->dev, dev->res);
+        if (!dev->provider)
+            return -ENOMEM;
+
+        return 0;
+    }
+
+    static void my_device_remove(struct platform_device *pdev)
+    {
+        struct my_device *dev = platform_get_drvdata(pdev);
+
+        revocable_provider_revoke(dev->provider);
+    }
+
+Consumer Side
+-------------
+
+::
+
+    struct my_consumer {
+        struct revocable *rev;
+    };
+
+    static int access_resource(struct my_consumer *cons)
+    {
+        struct resource *res;
+        int idx;
+        int ret = 0;
+
+        res = revocable_try_access(cons->rev, &idx);
+        if (!res) {
+            return -ENODEV;  // Resource was revoked
+        }
+
+        ret = do_something_with(res);
+
+        revocable_withdraw_access(cons->rev, idx);
+        return ret;
+    }
+
+    // Alternatively, using the convenience macro:
+    static int access_resource_with_macro(struct my_consumer *cons)
+    {
+        // REVOCABLE_TRY_ACCESS_WITH(cons->rev, res) {
+        //     if (res)
+        //         return do_something_with(res);
+        // }
+    }
+
+API Reference
+=============
+
+Provider API
+------------
+
+.. kernel-doc:: drivers/base/revocable.c
+   :functions: revocable_provider_alloc devm_revocable_provider_alloc revocable_provider_revoke
+
+Consumer API
+------------
+
+.. kernel-doc:: drivers/base/revocable.c
+   :functions: revocable_alloc revocable_free revocable_try_access revocable_withdraw_access
+
+Macros
+------
+
+.. kernel-doc:: include/linux/revocable.h
+   :functions: REVOCABLE_TRY_ACCESS_WITH
