+/**
+ * apparmor_cred_getsecid - get the secid of a cred's current label
+ * @c: the cred to query (NOT NULL)
+ * @secid: (output) the cred's label's secid, or AA_SECID_INVALID
+ *
+ * Every aa_label gets a secid at creation time (aa_label_init() calls
+ * aa_alloc_secid() unconditionally, including for the unconfined label),
+ * so this always has a real secid to report for any live cred - it was
+ * simply never exposed through this hook before. No AppArmor LSM was
+ * implementing security_cred_getsecid(), so callers of it (e.g. binder's
+ * txn_security_ctx) always got secid 0, which AppArmor never allocates
+ * (allocation starts at AA_FIRST_SECID=2) - every subsequent
+ * secid_to_secctx() lookup then failed with -EINVAL, regardless of the
+ * caller's actual label.
+ *
+ * No refcounting needed: secids are deliberately not refcounted against
+ * their label (see the comment on aa_secids above) - this matches the
+ * existing read of cred_label()/prop->apparmor.label in
+ * apparmor_lsmprop_to_secctx() below.
+ */
+void apparmor_cred_getsecid(const struct cred *c, u32 *secid)
+{
+	struct aa_label *label = cred_label(c);
+
+	*secid = label ? label->secid : AA_SECID_INVALID;
+}
+
 int apparmor_secid_to_secctx(u32 secid, struct lsm_context *cp)
 {
 	struct aa_label *label = aa_secid_to_label(secid);
