+	/* Abort latency histogram (time from grant to abort) */
+	unsigned long	s_abort_lt100us;	/* < 100us  - grant wasted */
+	unsigned long	s_abort_lt1ms;		/* 100us-1ms */
+	unsigned long	s_abort_lt5ms;		/* 1ms-5ms */
+	unsigned long	s_abort_lt10ms;		/* 5ms-10ms */
+	unsigned long	s_abort_gt10ms;		/* > 10ms   - full use */
+	unsigned long long s_abort_total_ns;	/* sum of all abort latencies (ns) */
