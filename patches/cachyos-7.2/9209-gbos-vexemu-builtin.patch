+// SPDX-License-Identifier: GPL-2.0
+/* GENERATED by kernel/builtin/gbos-vexemu-builtin.py from kernel/vexemu/gbos_vexemu.c (sha256 bfc60da0cf406de6).
+ * Built-in variant; do not edit here, edit the module source and regenerate. */
+/*
+ * gbos_vexemu - out-of-tree module: emulate x86 instructions the CPU lacks, on #UD.
+ *
+ * Emulates, for 64-bit user space only: GFNI (gf2p8affine[inv]qb, gf2p8mulb), VAES (vaesenc, vaesdec and the -last forms),
+ * VPCLMULQDQ, AVX-VNNI (vpdpbusd/s, vpdpwssd/s), AVX-IFMA (vpmadd52luq/huq) and SHA-NI (sha1*, sha256*).
+ * Anything else, and anything it is unsure about, is left alone so the kernel delivers its normal SIGILL.
+ *
+ * It hooks the die-notifier chain (DIE_TRAP / X86_TRAP_UD), which runs before SIGILL is sent, so it needs
+ * no kernel patch - only exported symbols. Each emulated instruction costs a trap (microseconds).
+ *
+ * The arithmetic (churro_math.inc) is NOT part of this file: build.sh extracts it from a pinned
+ * third-party patch at build time. See ../README.md.
+ */
+#include <linux/module.h>
+#include <linux/kdebug.h>
+#include <linux/uaccess.h>
+#include <linux/sched.h>
+#include <linux/ratelimit.h>
+#include <linux/atomic.h>
+#include <asm/fpu/api.h>
+#include <asm/fpu/types.h>
+#include <asm/processor.h>
+#include <asm/cpufeature.h>
+#include <asm/cpuid/api.h>
+#include <asm/traps.h>
+#include <asm/ptrace.h>
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Emulate GFNI/VAES/VPCLMULQDQ/AVX-VNNI/AVX-IFMA/SHA-NI on #UD");
+
+#ifndef CONFIG_PREEMPT_RCU
+#error "gbos_vexemu may sleep (user page faults) inside the die notifier; that needs CONFIG_PREEMPT_RCU"
+#endif
+
+enum churro_vex_op {
+	CHURRO_VPBUSD, CHURRO_VPBUSDS, CHURRO_VPWSSD, CHURRO_VPWSSDS,
+	CHURRO_VPM52LQ, CHURRO_VPM52HQ,
+	CHURRO_GFAFQ, CHURRO_GFAINVQ, CHURRO_GFMULB,
+	CHURRO_SHA1NEXTE, CHURRO_SHA1MSG1, CHURRO_SHA1MSG2,
+	CHURRO_SHA256RNDS2, CHURRO_SHA256MSG1, CHURRO_SHA256MSG2,
+	CHURRO_SHA1RNDS4,
+	CHURRO_PCLMULQDQ,
+	CHURRO_VAESENC, CHURRO_VAESENCLAST, CHURRO_VAESDEC, CHURRO_VAESDECLAST,
+	CHURRO_NR_OPS
+};
+
+static const char * const op_names[CHURRO_NR_OPS] = {
+	"vpdpbusd", "vpdpbusds", "vpdpwssd", "vpdpwssds", "vpmadd52luq", "vpmadd52huq",
+	"gf2p8affineqb", "gf2p8affineinvqb", "gf2p8mulb",
+	"sha1nexte", "sha1msg1", "sha1msg2", "sha256rnds2", "sha256msg1", "sha256msg2",
+	"sha1rnds4", "vpclmulqdq", "vaesenc", "vaesenclast", "vaesdec", "vaesdeclast",
+};
+
+static bool enabled = true;
+module_param(enabled, bool, 0644);
+MODULE_PARM_DESC(enabled, "emulate (default) or pass everything through to SIGILL");
+
+static bool verbose;
+module_param(verbose, bool, 0644);
+MODULE_PARM_DESC(verbose, "log (rate-limited) every emulated instruction");
+
+struct vstat {
+	u64 op[CHURRO_NR_OPS];
+	u64 ra, rejected;
+};
+static DEFINE_PER_CPU(struct vstat, vst);	/* per-CPU: a shared atomic counter bounces between cores on every trap */
+static DEFINE_RATELIMIT_STATE(rs, 5 * HZ, 5);
+
+/* ---- the arithmetic: generated by build.sh from the pinned third-party patch ---- */
+#undef core_initcall
+#define core_initcall(f)
+#if !__has_include("churro_math.inc")
+#error "gbos_vexemu: churro_math.inc is missing; run gbos-vexemu-builtin.py apply (it is third-party and kept out of the patch)"
+#endif
+#include "churro_math.inc"
+
+/* ---- xsave image access ----
+ * XMM low halves live in the legacy fxsave area, YMM-hi at the architectural standard offset (576 in
+ * both standard and compacted layout, since YMM is the first component after the 576-byte header).
+ * init() checks CPUID.(EAX=0DH,ECX=2) says the same.
+ */
+#define YMMH_OFF 576
+
+static void v_read(const struct xregs_state *xs, int n, u32 *v, bool y)
+{
+	if (xs->header.xfeatures & XFEATURE_MASK_SSE)
+		memcpy(v, &xs->i387.xmm_space[4 * n], 16);
+	else
+		memset(v, 0, 16);
+	if (!y)
+		return;
+	if (xs->header.xfeatures & XFEATURE_MASK_YMM)
+		memcpy((u8 *)v + 16, (const u8 *)xs + YMMH_OFF + 16 * n, 16);
+	else
+		memset((u8 *)v + 16, 0, 16);
+}
+
+static void v_write(struct xregs_state *xs, int n, const u32 *v, bool y, bool legacy)
+{
+	/* an init-state component's area is stale: zero it before it becomes live */
+	if (!(xs->header.xfeatures & XFEATURE_MASK_SSE)) {
+		memset(xs->i387.xmm_space, 0, sizeof(xs->i387.xmm_space));
+		xs->header.xfeatures |= XFEATURE_MASK_SSE;
+	}
+	memcpy(&xs->i387.xmm_space[4 * n], v, 16);
+	if (y) {
+		if (!(xs->header.xfeatures & XFEATURE_MASK_YMM)) {
+			xs->header.xfeatures |= XFEATURE_MASK_YMM;
+			memset((u8 *)xs + YMMH_OFF, 0, 16 * 16);
+		}
+		memcpy((u8 *)xs + YMMH_OFF + 16 * n, (const u8 *)v + 16, 16);
+	} else if (!legacy && (xs->header.xfeatures & XFEATURE_MASK_YMM)) {
+		memset((u8 *)xs + YMMH_OFF + 16 * n, 0, 16);	/* VEX.128 zeroes the upper half; legacy SSE keeps it */
+	}
+}
+
+static inline struct fpu *task_fpu(struct task_struct *t)
+{
+	/* same formula as the kernel's x86_task_fpu(): the fpu sits right behind task_struct */
+	return (struct fpu *)((void *)t + sizeof(*t));
+}
+
+/* ---- decoder ---- */
+struct modrm {
+	int mod, reg, rm;			/* reg/rm already include REX/VEX extension bits (rm only for mod == 3) */
+	bool mem, rip;
+	int base, index, scale;
+	long disp;
+};
+
+static unsigned long *gregp(struct pt_regs *r, int n)
+{
+	switch (n) {
+	case 0: return &r->ax;   case 1: return &r->cx;   case 2: return &r->dx;   case 3: return &r->bx;
+	case 4: return &r->sp;   case 5: return &r->bp;   case 6: return &r->si;   case 7: return &r->di;
+	case 8: return &r->r8;   case 9: return &r->r9;   case 10: return &r->r10; case 11: return &r->r11;
+	case 12: return &r->r12; case 13: return &r->r13; case 14: return &r->r14; default: return &r->r15;
+	}
+}
+
+/* parse ModRM [+SIB] [+disp] at b[*pp]; false if the bytes run out */
+static bool parse_modrm(const u8 *b, int n, int *pp, int rr, int rx, int rb, struct modrm *m)
+{
+	int p = *pp, modrm;
+	bool d32 = false;
+
+	if (p >= n)
+		return false;
+	modrm = b[p++];
+	m->mod = modrm >> 6;
+	m->reg = ((modrm >> 3) & 7) | (rr << 3);
+	m->rm = modrm & 7;
+	m->mem = m->mod != 3;
+	m->rip = false;
+	m->base = m->index = -1;
+	m->scale = 0;
+	m->disp = 0;
+	if (!m->mem) {
+		m->rm |= rb << 3;
+		*pp = p;
+		return true;
+	}
+	if (m->rm == 4) {
+		int sib, idx;
+
+		if (p >= n)
+			return false;
+		sib = b[p++];
+		m->scale = sib >> 6;
+		idx = ((sib >> 3) & 7) | (rx << 3);
+		m->index = idx == 4 ? -1 : idx;
+		if ((sib & 7) == 5 && m->mod == 0)
+			d32 = true;			/* no base, disp32 */
+		else
+			m->base = (sib & 7) | (rb << 3);
+	} else if (m->rm == 5 && m->mod == 0) {
+		m->rip = true;
+		d32 = true;
+	} else {
+		m->base = m->rm | (rb << 3);
+	}
+	if (m->mod == 1) {
+		if (p >= n)
+			return false;
+		m->disp = (s8)b[p++];
+	} else if (m->mod == 2 || d32) {
+		if (p + 4 > n)
+			return false;
+		m->disp = (s32)(b[p] | b[p + 1] << 8 | b[p + 2] << 16 | (u32)b[p + 3] << 24);
+		p += 4;
+	}
+	*pp = p;
+	return true;
+}
+
+/* effective address; len = total instruction length (RIP-relative is relative to the next instruction) */
+static unsigned long modrm_ea(const struct modrm *m, struct pt_regs *r, int len)
+{
+	unsigned long ea = m->disp;
+
+	if (m->rip)
+		ea += r->ip + len;
+	if (m->base >= 0)
+		ea += *gregp(r, m->base);
+	if (m->index >= 0)
+		ea += *gregp(r, m->index) << m->scale;
+	return ea;
+}
+
+/* the instructions this module exists for */
+struct dec {
+	int op, len, dst, s1, s2;
+	bool y, legacy, mem;
+	u8 imm;
+	unsigned long ea;
+};
+
+static bool decode(const u8 *b, int n, struct pt_regs *regs, struct dec *d)
+{
+	int p, map, pp, w, opc, rx = 0, rb = 0, rr = 0;
+	struct modrm m;
+	bool needimm = false;
+
+	memset(d, 0, sizeof(*d));
+	if (n < 5)
+		return false;
+
+	if (b[0] == 0xc4) {			/* 3-byte VEX, 66 prefix, maps 0F38/0F3A only */
+		map = b[1] & 0x1f;
+		pp = b[2] & 3;
+		w = b[2] >> 7;
+		rr = !(b[1] & 0x80);
+		rx = !(b[1] & 0x40);
+		rb = !(b[1] & 0x20);
+		opc = b[3];
+		p = 4;
+		if (pp != 1 || (map != 2 && map != 3))
+			return false;
+		d->y = (b[2] >> 2) & 1;
+		d->s1 = ~(b[2] >> 3) & 0xf;
+		if (map == 2) {
+			switch (opc) {
+			case 0x50: d->op = CHURRO_VPBUSD;  break;
+			case 0x51: d->op = CHURRO_VPBUSDS; break;
+			case 0x52: d->op = CHURRO_VPWSSD;  break;
+			case 0x53: d->op = CHURRO_VPWSSDS; break;
+			case 0xb4: d->op = CHURRO_VPM52LQ; break;
+			case 0xb5: d->op = CHURRO_VPM52HQ; break;
+			case 0xcf: d->op = CHURRO_GFMULB;  break;
+			case 0xdc: d->op = CHURRO_VAESENC;      break;
+			case 0xdd: d->op = CHURRO_VAESENCLAST;  break;
+			case 0xde: d->op = CHURRO_VAESDEC;      break;
+			case 0xdf: d->op = CHURRO_VAESDECLAST;  break;
+			default: return false;
+			}
+			/* IFMA has VEX.W=1; VNNI and GF2P8MULB have W=0; VAES ignores W */
+			if (d->op < CHURRO_VAESENC &&
+			    (d->op == CHURRO_VPM52LQ || d->op == CHURRO_VPM52HQ) != !!w)
+				return false;
+		} else {
+			needimm = true;
+			switch (opc) {
+			case 0x44: if (w) return false;  d->op = CHURRO_PCLMULQDQ; break;
+			case 0xce: if (!w) return false; d->op = CHURRO_GFAFQ;     break;
+			case 0xcf: if (!w) return false; d->op = CHURRO_GFAINVQ;   break;
+			default: return false;
+			}
+		}
+	} else {				/* SHA-NI, legacy NP encodings: [REX] 0F 38 C8..CD /r, [REX] 0F 3A CC /r ib */
+		p = 0;
+		if ((b[0] & 0xf0) == 0x40) {
+			rr = !!(b[0] & 4);
+			rx = !!(b[0] & 2);
+			rb = !!(b[0] & 1);
+			p++;
+		}
+		if (b[p] != 0x0f)
+			return false;
+		if (b[p + 1] == 0x38 && b[p + 2] >= 0xc8 && b[p + 2] <= 0xcd) {
+			d->op = CHURRO_SHA1NEXTE + b[p + 2] - 0xc8;
+		} else if (b[p + 1] == 0x3a && b[p + 2] == 0xcc) {
+			d->op = CHURRO_SHA1RNDS4;
+			needimm = true;
+		} else {
+			return false;
+		}
+		p += 3;
+		d->legacy = true;
+		d->s1 = 0;			/* sha256rnds2's implicit third operand is xmm0 */
+	}
+
+	if (!parse_modrm(b, n, &p, rr, rx, rb, &m))
+		return false;
+	d->dst = m.reg;
+	d->mem = m.mem;
+	d->s2 = m.rm;
+	if (needimm) {
+		if (p >= n)
+			return false;
+		d->imm = b[p++];
+	}
+	d->len = p;
+	if (d->mem) {
+		d->ea = modrm_ea(&m, regs, d->len);
+		/* legacy SSE memory operands must be 16-byte aligned (#GP on hardware, not #UD): don't mask that */
+		if (d->legacy && (d->ea & 15))
+			return false;
+	}
+	return true;
+}
+
+/* ---- run-ahead ----
+ * After an emulated instruction, keep interpreting the straight-line code that follows in the same trap, so a
+ * loop of N instructions costs about one trap instead of N. Only instructions that are cheap to get exactly right
+ * are interpreted: loads (never stores), integer-free vector ALU ops, lea and nops. Everything else - a store,
+ * a branch, a flag-setting op, an unknown opcode, a prefix we do not model, an unreadable or misaligned
+ * operand - simply ends the run: the CPU executes that instruction itself, so stopping is always correct.
+ * None of the interpreted instructions touch EFLAGS.
+ *   legacy SSE (SHA-256 loops):  movdqa/movdqu/movaps/movups load, paddd, pshufd, pshufb, palignr, punpck[lh]qdq, sha*, lea, nop
+ *   VEX (checksum/codec loops):  vmovdqa/vmovdqu/vmovaps/vmovups load, vpxor, vpaddd, vpmaddwd, vpsadbw, vpmaddubsw, vpdp*
+ */
+#define RA_MAX 256
+
+/*
+ * Non-faulting read of user memory: false if not resident / not accessible. Deliberately not copy_from_user_nofault():
+ * that goes through the hardened-usercopy checks (check_object_size -> check_stack_object, a stack-frame walk), which
+ * profiled at ~20% of all CPU on the slate. These are our own bounded buffers, so unsafe_get_user() is enough.
+ */
+static bool uread(void *dst, unsigned long addr, size_t n)
+{
+	u8 *d = dst;
+	size_t i;
+
+	if (addr >= TASK_SIZE_MAX || n > TASK_SIZE_MAX - addr)
+		return false;
+	pagefault_disable();
+	if (!user_read_access_begin((const void __user *)addr, n)) {
+		pagefault_enable();
+		return false;
+	}
+	for (i = 0; i + 8 <= n; i += 8) {
+		u64 v;
+
+		unsafe_get_user(v, (u64 __user *)(addr + i), efault);
+		memcpy(d + i, &v, 8);
+	}
+	for (; i < n; i++) {
+		u8 v;
+
+		unsafe_get_user(v, (u8 __user *)(addr + i), efault);
+		d[i] = v;
+	}
+	user_read_access_end();
+	pagefault_enable();
+	return true;
+efault:
+	user_read_access_end();
+	pagefault_enable();
+	return false;
+}
+
+struct ra {
+	u32 x[16][8];				/* full YMM copies, loaded on first use */
+	u16 valid, dirty;
+	struct xregs_state *xs;
+	u8 win[64];				/* instruction bytes at wbase, so most steps need no user read */
+	unsigned long wbase;
+	int wlen;
+};
+
+static u32 *xr(struct ra *R, int n)
+{
+	if (!(R->valid & (1 << n))) {
+		v_read(R->xs, n, R->x[n], true);
+		R->valid |= 1 << n;
+	}
+	return R->x[n];
+}
+
+/* the instruction bytes at ip: a pointer into the window and how many bytes are available (0 = unreadable) */
+static int ra_window(struct ra *R, unsigned long ip, const u8 **bp)
+{
+	if (ip < R->wbase || ip - R->wbase + 16 > R->wlen) {
+		int n = sizeof(R->win);
+
+		if (!uread(R->win, ip, n)) {
+			n = min_t(int, n, PAGE_SIZE - (ip & ~PAGE_MASK));	/* maybe only the rest of this page is mapped */
+			if (n < 1 || !uread(R->win, ip, n))
+				return 0;
+		}
+		R->wbase = ip;
+		R->wlen = n;
+	}
+	*bp = R->win + (ip - R->wbase);
+	return R->wlen - (ip - R->wbase);
+}
+
+
+/* store to user memory without faulting: false if not mapped/writable (the CPU then runs the real instruction and faults properly) */
+static bool uwrite(unsigned long addr, const void *src, size_t n)
+{
+	const u8 *sp = src;
+	size_t i;
+
+	if (addr >= TASK_SIZE_MAX || n > TASK_SIZE_MAX - addr)
+		return false;
+	pagefault_disable();
+	if (!user_write_access_begin((void __user *)addr, n)) {
+		pagefault_enable();
+		return false;
+	}
+	for (i = 0; i + 8 <= n; i += 8) {
+		u64 v;
+
+		memcpy(&v, sp + i, 8);
+		unsafe_put_user(v, (u64 __user *)(addr + i), efault);
+	}
+	user_write_access_end();
+	pagefault_enable();
+	return true;
+efault:
+	user_write_access_end();
+	pagefault_enable();
+	return false;
+}
+
+/* execute one of the instructions this module emulates; vb = the second source (register or loaded memory operand) */
+static void exec_op(struct ra *R, const struct dec *d, const u32 *vb)
+{
+	u32 vd[8];
+	int op = d->op;
+
+	if (op >= CHURRO_VAESENC)
+		churro_vex_aes((u8 *)vd, (u8 *)xr(R, d->s1), (u8 *)vb, d->y ? 2 : 1, op);
+	else if (op == CHURRO_PCLMULQDQ)
+		churro_pclmul_exec((u64 *)vd, (const u64 *)xr(R, d->s1), (const u64 *)vb, d->y ? 2 : 1, d->imm);
+	else if (op >= CHURRO_SHA1NEXTE)
+		churro_sha_exec(vd, xr(R, d->dst), vb, xr(R, d->s1), op, d->imm);
+	else if (op >= CHURRO_GFAFQ)
+		churro_vex_gfni((u8 *)vd, (u8 *)xr(R, d->s1), (u8 *)vb, d->y ? 32 : 16, op, d->imm);
+	else if (op >= CHURRO_VPM52LQ)
+		churro_vex_madd52((u64 *)vd, (u64 *)xr(R, d->dst), (u64 *)xr(R, d->s1), (u64 *)vb, d->y ? 4 : 2, op == CHURRO_VPM52HQ);
+	else
+		churro_vex_vnni_exec(vd, xr(R, d->dst), xr(R, d->s1), vb, d->y ? 8 : 4, op);
+	/* result into the register image: 256-bit forms replace it all; 128-bit VEX zeroes the upper half; legacy SSE keeps it */
+	if (d->y) {
+		memcpy(xr(R, d->dst), vd, 32);
+	} else {
+		memcpy(xr(R, d->dst), vd, 16);
+		if (!d->legacy)
+			memset((u8 *)xr(R, d->dst) + 16, 0, 16);
+	}
+	R->dirty |= 1 << d->dst;
+}
+
+static bool runahead = true;
+module_param(runahead, bool, 0644);
+MODULE_PARM_DESC(runahead, "interpret the simple vector code after an emulated instruction (default on)");
+
+static inline s32 sat16(s32 v)
+{
+	return v > 32767 ? 32767 : v < -32768 ? -32768 : v;
+}
+
+enum ra_vex_op { RAV_PXOR, RAV_PADDD, RAV_PMADDWD, RAV_PSADBW, RAV_PMADDUBSW, RAV_PAND, RAV_PANDN, RAV_POR, RAV_PADDQ,
+		 RAV_PSHUFB, RAV_PALIGNR, RAV_PUNPCKLQDQ, RAV_PUNPCKHQDQ, RAV_PSHUFD };
+
+/* the lane-wise VEX ALU ops, on 32-byte values: d = a OP b */
+static void ra_vex_alu(u32 *d, const u32 *a, const u32 *b, int op, u8 imm)
+{
+	const s16 *aw = (const s16 *)a, *bw = (const s16 *)b;
+	const u8 *ab = (const u8 *)a;
+	const s8 *bb = (const s8 *)b;
+	u32 t[8];
+	int i, j;
+
+	switch (op) {
+	case RAV_PXOR:
+		for (i = 0; i < 8; i++)
+			t[i] = a[i] ^ b[i];
+		break;
+	case RAV_PADDD:
+		for (i = 0; i < 8; i++)
+			t[i] = a[i] + b[i];
+		break;
+	case RAV_PMADDWD:
+		for (i = 0; i < 8; i++)
+			t[i] = (u32)((s32)aw[2 * i] * bw[2 * i] + (s32)aw[2 * i + 1] * bw[2 * i + 1]);
+		break;
+	case RAV_PSADBW:
+		for (i = 0; i < 4; i++) {
+			u32 sum = 0;
+
+			for (j = 0; j < 8; j++) {
+				int x = ((const u8 *)a)[8 * i + j], y = ((const u8 *)b)[8 * i + j];
+
+				sum += x > y ? x - y : y - x;
+			}
+			t[2 * i] = sum;
+			t[2 * i + 1] = 0;
+		}
+		break;
+	case RAV_PAND:
+		for (i = 0; i < 8; i++)
+			t[i] = a[i] & b[i];
+		break;
+	case RAV_PANDN:				/* (~src1) & src2 */
+		for (i = 0; i < 8; i++)
+			t[i] = ~a[i] & b[i];
+		break;
+	case RAV_POR:
+		for (i = 0; i < 8; i++)
+			t[i] = a[i] | b[i];
+		break;
+	case RAV_PADDQ:
+		for (i = 0; i < 4; i++) {
+			u64 x, y;
+
+			memcpy(&x, (const u8 *)a + 8 * i, 8);
+			memcpy(&y, (const u8 *)b + 8 * i, 8);
+			x += y;
+			memcpy((u8 *)t + 8 * i, &x, 8);
+		}
+		break;
+	case RAV_PSHUFB:			/* bytes of src1, selected per 128-bit lane by src2 */
+		for (i = 0; i < 32; i++) {
+			u8 c = ((const u8 *)b)[i];
+
+			((u8 *)t)[i] = c & 0x80 ? 0 : ab[(i & 16) + (c & 15)];
+		}
+		break;
+	case RAV_PALIGNR:			/* per lane: (src1:src2) >> imm bytes, low 16 */
+		for (i = 0; i < 32; i++) {
+			int idx = (i & 15) + imm;
+
+			((u8 *)t)[i] = idx < 16 ? ((const u8 *)b)[(i & 16) + idx] :
+				       idx < 32 ? ab[(i & 16) + idx - 16] : 0;
+		}
+		break;
+	case RAV_PUNPCKLQDQ:			/* per lane: [src1.q0, src2.q0] */
+	case RAV_PUNPCKHQDQ: {
+		int hi = op == RAV_PUNPCKHQDQ;
+
+		for (i = 0; i < 2; i++) {
+			memcpy((u8 *)t + 16 * i, (const u8 *)a + 16 * i + 8 * hi, 8);
+			memcpy((u8 *)t + 16 * i + 8, (const u8 *)b + 16 * i + 8 * hi, 8);
+		}
+		break;
+	}
+	case RAV_PSHUFD:			/* per lane, dwords of src2 (the rm operand) */
+		for (i = 0; i < 8; i++)
+			t[i] = b[(i & ~3) + ((imm >> (2 * (i & 3))) & 3)];
+		break;
+	default: /* RAV_PMADDUBSW: a = unsigned bytes (src1), b = signed bytes (src2) */
+		for (i = 0; i < 16; i++) {
+			s32 v = (s32)ab[2 * i] * bb[2 * i] + (s32)ab[2 * i + 1] * bb[2 * i + 1];
+
+			((s16 *)t)[i] = sat16(v);
+		}
+		break;
+	}
+	memcpy(d, t, 32);
+}
+
+/* legacy-SSE ops on 16 bytes: d = d OP s (x0 = xmm0 for sha256rnds2) */
+enum ra_sse_op { RAS_MOV, RAS_PADDD, RAS_PSHUFD, RAS_PALIGNR, RAS_PSHUFB, RAS_PUNPCKLQDQ, RAS_PUNPCKHQDQ, RAS_SHA,
+		 RAS_PXOR, RAS_POR, RAS_PAND, RAS_PANDN, RAS_PADDQ };
+
+static void ra_sse(u32 *d, const u32 *s, const u32 *x0, int kind, int sha_op, u8 imm)
+{
+	const u8 *sb = (const u8 *)s;
+	u8 *db = (u8 *)d, b[32];
+	u32 t[4];
+	int i;
+
+	switch (kind) {
+	case RAS_MOV:
+		memcpy(d, s, 16);
+		return;
+	case RAS_PADDD:
+		for (i = 0; i < 4; i++)
+			d[i] += s[i];
+		return;
+	case RAS_PXOR:
+		for (i = 0; i < 4; i++)
+			d[i] ^= s[i];
+		return;
+	case RAS_POR:
+		for (i = 0; i < 4; i++)
+			d[i] |= s[i];
+		return;
+	case RAS_PAND:
+		for (i = 0; i < 4; i++)
+			d[i] &= s[i];
+		return;
+	case RAS_PANDN:				/* (~dst) & src */
+		for (i = 0; i < 4; i++)
+			d[i] = ~d[i] & s[i];
+		return;
+	case RAS_PADDQ:
+		for (i = 0; i < 2; i++) {
+			u64 x, y;
+
+			memcpy(&x, (u8 *)d + 8 * i, 8);
+			memcpy(&y, (const u8 *)s + 8 * i, 8);
+			x += y;
+			memcpy((u8 *)d + 8 * i, &x, 8);
+		}
+		return;
+	case RAS_PSHUFD:
+		for (i = 0; i < 4; i++)
+			t[i] = s[(imm >> (2 * i)) & 3];
+		memcpy(d, t, 16);
+		return;
+	case RAS_PALIGNR:			/* (dest:src) >> imm bytes, low 16 */
+		memcpy(b, s, 16);
+		memcpy(b + 16, d, 16);
+		for (i = 0; i < 16; i++)
+			db[i] = i + imm < 32 ? b[i + imm] : 0;
+		return;
+	case RAS_PSHUFB:
+		memcpy(b, d, 16);
+		for (i = 0; i < 16; i++)
+			db[i] = sb[i] & 0x80 ? 0 : b[sb[i] & 15];
+		return;
+	case RAS_PUNPCKLQDQ:
+		d[2] = s[0];
+		d[3] = s[1];
+		return;
+	case RAS_PUNPCKHQDQ:
+		d[0] = d[2];
+		d[1] = d[3];
+		d[2] = s[2];
+		d[3] = s[3];
+		return;
+	default:
+		churro_sha_exec(t, d, s, x0, sha_op, imm);
+		memcpy(d, t, 16);
+		return;
+	}
+}
+
+/* interpret the instruction at r->ip; false = stop here (the CPU will run it) */
+static bool ra_step(struct pt_regs *r, struct ra *R)
+{
+	const u8 *b;
+	struct modrm m;
+	int n, p = 0, len, i;
+	bool p66 = false, pf3 = false;
+	int rex = 0, rr = 0, rx = 0, rb = 0;
+	u32 src[8];
+	unsigned long ea;
+
+	n = ra_window(R, r->ip, &b);
+	if (n < 2)
+		return false;
+
+	/* ---- one of the emulated instructions itself (VAES, VPCLMULQDQ, SHA, GFNI, VNNI ...) ---- */
+	{
+		struct dec d;
+		u32 vb[8];
+
+		if (decode(b, n, r, &d)) {
+			if (d.mem) {
+				memset(vb, 0, sizeof(vb));
+				if (!uread(vb, d.ea, d.y ? 32 : 16))
+					return false;
+			} else {
+				memcpy(vb, xr(R, d.s2), 32);
+			}
+			exec_op(R, &d, vb);
+			r->ip += d.len;
+			return true;
+		}
+	}
+
+	/* ---- VEX (2- or 3-byte) ---- */
+	if (b[0] == 0xc5 || b[0] == 0xc4) {
+		int map, pp, vl, vvvv, opc, w = 0;
+		bool is3 = b[0] == 0xc4;
+
+		if (is3 ? n < 5 : n < 4)
+			return false;
+		if (is3) {
+			rr = !(b[1] & 0x80); rx = !(b[1] & 0x40); rb = !(b[1] & 0x20);
+			map = b[1] & 0x1f; w = b[2] >> 7; vvvv = ~(b[2] >> 3) & 0xf; vl = (b[2] >> 2) & 1; pp = b[2] & 3;
+			opc = b[3]; p = 4;
+		} else {
+			rr = !(b[1] & 0x80); map = 1; vvvv = ~(b[1] >> 3) & 0xf; vl = (b[1] >> 2) & 1; pp = b[1] & 3;
+			opc = b[2]; p = 3;
+		}
+		int kind = -1, vnni = -1;
+		bool mov = false, aligned = false, store = false, needimm = false;
+		u8 imm = 0;
+
+		if (map == 1 && pp == 2 && opc == 0x6f)      { mov = true; }				/* vmovdqu */
+		else if (map == 1 && pp == 1 && opc == 0x6f) { mov = true; aligned = true; }	/* vmovdqa */
+		else if (map == 1 && pp == 0 && opc == 0x28) { mov = true; aligned = true; }	/* vmovaps load */
+		else if (map == 1 && pp == 0 && opc == 0x10) { mov = true; }			/* vmovups load */
+		else if (map == 1 && pp == 2 && opc == 0x7f) { store = true; }			/* vmovdqu store */
+		else if (map == 1 && pp == 1 && opc == 0x7f) { store = true; aligned = true; }	/* vmovdqa store */
+		else if (map == 1 && pp == 0 && opc == 0x11) { store = true; }			/* vmovups store */
+		else if (map == 1 && pp == 0 && opc == 0x29) { store = true; aligned = true; }	/* vmovaps store */
+		else if (map == 1 && pp == 1 && opc == 0xdb) kind = RAV_PAND;
+		else if (map == 1 && pp == 1 && opc == 0xdf) kind = RAV_PANDN;
+		else if (map == 1 && pp == 1 && opc == 0xeb) kind = RAV_POR;
+		else if (map == 1 && pp == 1 && opc == 0xd4) kind = RAV_PADDQ;
+		else if (map == 1 && pp == 1 && opc == 0x6c) kind = RAV_PUNPCKLQDQ;
+		else if (map == 1 && pp == 1 && opc == 0x6d) kind = RAV_PUNPCKHQDQ;
+		else if (map == 1 && pp == 1 && opc == 0x70) { kind = RAV_PSHUFD; needimm = true; }
+		else if (map == 2 && pp == 1 && opc == 0x00) kind = RAV_PSHUFB;
+		else if (map == 3 && pp == 1 && opc == 0x0f) { kind = RAV_PALIGNR; needimm = true; }
+		else if (map == 1 && pp == 1 && opc == 0xef) kind = RAV_PXOR;
+		else if (map == 1 && pp == 1 && opc == 0xfe) kind = RAV_PADDD;
+		else if (map == 1 && pp == 1 && opc == 0xf5) kind = RAV_PMADDWD;
+		else if (map == 1 && pp == 1 && opc == 0xf6) kind = RAV_PSADBW;
+		else if (map == 2 && pp == 1 && opc == 0x04) kind = RAV_PMADDUBSW;
+		else if (map == 2 && pp == 1 && !w && opc >= 0x50 && opc <= 0x53) vnni = CHURRO_VPBUSD + opc - 0x50;
+		else return false;
+		if (!parse_modrm(b, n, &p, rr, rx, rb, &m))
+			return false;
+		if (needimm) {
+			if (p >= n)
+				return false;
+			imm = b[p++];
+		}
+		len = p;
+		if ((mov || kind == RAV_PSHUFD || store) && vvvv)
+			return false;
+		if (store) {
+			if (!m.mem)
+				return false;
+			ea = modrm_ea(&m, r, len);
+			if ((aligned && (ea & (vl ? 31 : 15))) || !uwrite(ea, xr(R, m.reg), vl ? 32 : 16))
+				return false;
+			r->ip += len;
+			return true;
+		}
+		if (m.mem) {
+			ea = modrm_ea(&m, r, len);
+			if ((aligned && (ea & (vl ? 31 : 15))) || ea >= TASK_SIZE_MAX)
+				return false;
+			memset(src, 0, sizeof(src));
+			if (!uread(src, ea, vl ? 32 : 16))
+				return false;
+		} else {
+			memcpy(src, xr(R, m.rm), 32);
+		}
+		if (mov) {
+			memcpy(xr(R, m.reg), src, 32);
+		} else if (vnni >= 0) {
+			u32 d[8];
+
+			churro_vex_vnni_exec(d, xr(R, m.reg), xr(R, vvvv), src, vl ? 8 : 4, vnni);
+			memcpy(xr(R, m.reg), d, 32);
+		} else {
+			ra_vex_alu(xr(R, m.reg), xr(R, vvvv), src, kind, imm);
+		}
+		if (!vl)
+			memset((u8 *)xr(R, m.reg) + 16, 0, 16);		/* VEX.128 zeroes the upper half */
+		R->dirty |= 1 << m.reg;
+		r->ip += len;
+		return true;
+	}
+
+	/* ---- legacy: prefixes (at most one 66 or F3), REX ---- */
+	while (p < n && (b[p] == 0x66 || b[p] == 0xf3)) {
+		if (p66 || pf3)
+			return false;
+		if (b[p] == 0x66) p66 = true; else pf3 = true;
+		p++;
+	}
+	if (p < n && (b[p] & 0xf0) == 0x40) {
+		rex = b[p++];
+		rr = !!(rex & 4); rx = !!(rex & 2); rb = !!(rex & 1);
+	}
+	if (p + 1 >= n)
+		return false;
+
+	if (b[p] == 0x90 && !p66 && !pf3 && !rex) {			/* nop */
+		r->ip += p + 1;
+		return true;
+	}
+	if (b[p] == 0x8d && !p66 && !pf3 && (rex & 8)) {		/* lea r64, m */
+		p++;
+		if (!parse_modrm(b, n, &p, rr, rx, rb, &m) || !m.mem)
+			return false;
+		*gregp(r, m.reg) = modrm_ea(&m, r, p);
+		r->ip += p;
+		return true;
+	}
+	if (b[p] != 0x0f)
+		return false;
+	{
+		int kind = 0, sha_op = 0, opc, map = 0;
+		bool needimm = false, aligned = true, store = false;
+		u8 imm = 0;
+
+		p++;
+		opc = b[p++];
+		if (opc == 0x1f && !pf3) {				/* multi-byte nop: 0F 1F /0 (66 allowed) */
+			if (!parse_modrm(b, n, &p, 0, 0, 0, &m))
+				return false;
+			r->ip += p;
+			return true;
+		}
+		if (opc == 0x38 || opc == 0x3a) {
+			map = opc;
+			if (p >= n)
+				return false;
+			opc = b[p++];
+		}
+		if (map == 0x38 && !p66 && !pf3 && opc >= 0xc8 && opc <= 0xcd) {
+			kind = RAS_SHA; sha_op = CHURRO_SHA1NEXTE + opc - 0xc8;
+		} else if (map == 0x3a && !p66 && !pf3 && opc == 0xcc) {
+			kind = RAS_SHA; sha_op = CHURRO_SHA1RNDS4; needimm = true;
+		} else if (!map && pf3 && opc == 0x6f) {
+			kind = RAS_MOV; aligned = false;		/* movdqu */
+		} else if (!map && !p66 && !pf3 && opc == 0x28) {
+			kind = RAS_MOV;					/* movaps load */
+		} else if (!map && !p66 && !pf3 && opc == 0x10) {
+			kind = RAS_MOV; aligned = false;		/* movups load */
+		} else if (!map && pf3 && opc == 0x7f) {
+			store = true; aligned = false;			/* movdqu store */
+		} else if (!map && !p66 && !pf3 && opc == 0x29) {
+			store = true;					/* movaps store */
+		} else if (!map && !p66 && !pf3 && opc == 0x11) {
+			store = true; aligned = false;			/* movups store */
+		} else if (!p66 || pf3) {
+			return false;
+		} else if (!map && opc == 0x6f) {
+			kind = RAS_MOV;					/* movdqa */
+		} else if (!map && opc == 0x7f) {
+			store = true;					/* movdqa store */
+		} else if (!map && opc == 0xef) {
+			kind = RAS_PXOR;
+		} else if (!map && opc == 0xeb) {
+			kind = RAS_POR;
+		} else if (!map && opc == 0xdb) {
+			kind = RAS_PAND;
+		} else if (!map && opc == 0xdf) {
+			kind = RAS_PANDN;
+		} else if (!map && opc == 0xd4) {
+			kind = RAS_PADDQ;
+		} else if (!map && opc == 0xfe) {
+			kind = RAS_PADDD;
+		} else if (!map && opc == 0x70) {
+			kind = RAS_PSHUFD; needimm = true;
+		} else if (!map && opc == 0x6c) {
+			kind = RAS_PUNPCKLQDQ;
+		} else if (!map && opc == 0x6d) {
+			kind = RAS_PUNPCKHQDQ;
+		} else if (map == 0x38 && opc == 0x00) {
+			kind = RAS_PSHUFB;
+		} else if (map == 0x3a && opc == 0x0f) {
+			kind = RAS_PALIGNR; needimm = true;
+		} else {
+			return false;
+		}
+		if (!parse_modrm(b, n, &p, rr, rx, rb, &m))
+			return false;
+		if (needimm) {
+			if (p >= n)
+				return false;
+			imm = b[p++];
+		}
+		len = p;
+		if (store) {
+			if (!m.mem)
+				return false;
+			ea = modrm_ea(&m, r, len);
+			if ((aligned && (ea & 15)) || !uwrite(ea, xr(R, m.reg), 16))
+				return false;
+			r->ip += len;
+			return true;
+		}
+		if (m.mem) {
+			ea = modrm_ea(&m, r, len);
+			if ((aligned && (ea & 15)) || ea >= TASK_SIZE_MAX || !uread(src, ea, 16))
+				return false;
+		} else {
+			memcpy(src, xr(R, m.rm), 16);
+		}
+		ra_sse(xr(R, m.reg), src, xr(R, 0), kind, sha_op, imm);
+		R->dirty |= 1 << m.reg;
+		r->ip += len;
+		(void)i;
+		return true;
+	}
+}
+
+/* ---- execution ---- */
+static bool emulate(struct pt_regs *regs)
+{
+	u8 buf[16];
+	u32 vb[8];
+	struct dec d;
+	struct fpu *fpu;
+	struct xregs_state *xs;
+	struct ra R;
+	struct pt_regs r;
+	int n, op, i, extra = 0;
+
+	n = sizeof(buf);
+	if (!uread(buf, regs->ip, n))
+		n = sizeof(buf) - copy_from_user(buf, (void __user *)regs->ip, sizeof(buf));
+	if (!decode(buf, n, regs, &d))
+		return false;
+	op = d.op;
+
+	memset(vb, 0, sizeof(vb));
+	if (d.mem && copy_from_user(vb, (void __user *)d.ea, d.y ? 32 : 16))
+		return false;			/* hardware would #PF/#SS here, not #UD: fall back to SIGILL */
+
+	fpu = task_fpu(current);
+	kernel_fpu_begin();			/* saves the user's registers into fpstate and keeps the CPU's copy out of play */
+	xs = &fpu->fpstate->regs.xsave;
+	R.xs = xs;
+	R.valid = R.dirty = 0;
+	R.wlen = 0;
+	R.wbase = 0;
+	if (!d.mem)
+		memcpy(vb, xr(&R, d.s2), d.y ? 32 : 16);
+
+	exec_op(&R, &d, vb);
+
+	r = *regs;
+	r.ip += d.len;
+	if (runahead && !(regs->flags & X86_EFLAGS_TF)) {
+		while (extra < RA_MAX && ra_step(&r, &R))
+			extra++;
+		this_cpu_add(vst.ra, extra);
+	}
+	for (i = 0; i < 16; i++)
+		if (R.dirty & (1 << i))
+			v_write(xs, i, R.x[i], true, false);
+	kernel_fpu_end();
+
+	*regs = r;				/* new ip, and any GPR a lea changed */
+	this_cpu_inc(vst.op[op]);
+	if (verbose && __ratelimit(&rs))
+		pr_info("gbos_vexemu: %s in %s[%d] at %lx (+%d run-ahead)\n", op_names[op], current->comm,
+			task_pid_nr(current), regs->ip, extra);
+	return true;
+}
+
+static int ud_notify(struct notifier_block *nb, unsigned long val, void *data)
+{
+	struct die_args *a = data;
+	bool done, irq;
+
+	if (val != DIE_TRAP || a->trapnr != X86_TRAP_UD || !a->regs || !user_mode(a->regs) || !enabled)
+		return NOTIFY_DONE;
+
+	/* same as the kernel does before do_trap(): user page faults need interrupts back on */
+	irq = a->regs->flags & X86_EFLAGS_IF;
+	if (irq)
+		local_irq_enable();
+	done = emulate(a->regs);
+	if (irq)
+		local_irq_disable();
+	if (!done) {
+		this_cpu_inc(vst.rejected);
+		return NOTIFY_DONE;
+	}
+	return NOTIFY_STOP;			/* suppresses the SIGILL */
+}
+
+static struct notifier_block nb = { .notifier_call = ud_notify, .priority = 100 };
+
+static int stats_get(char *buf, const struct kernel_param *kp)
+{
+	int i, n = 0;
+
+	u64 ra = 0, rej = 0;
+	int c;
+
+	for (i = 0; i < CHURRO_NR_OPS; i++) {
+		u64 t = 0;
+
+		for_each_possible_cpu(c)
+			t += per_cpu(vst, c).op[i];
+		n += scnprintf(buf + n, PAGE_SIZE - n, "%s=%llu\n", op_names[i], t);
+	}
+	for_each_possible_cpu(c) {
+		ra += per_cpu(vst, c).ra;
+		rej += per_cpu(vst, c).rejected;
+	}
+	n += scnprintf(buf + n, PAGE_SIZE - n, "runahead_instructions=%llu\n", ra);
+	return n + scnprintf(buf + n, PAGE_SIZE - n, "passed_to_sigill=%llu\n", rej);
+}
+static const struct kernel_param_ops stats_ops = { .get = stats_get };
+module_param_cb(stats, &stats_ops, NULL, 0444);
+
+static int __init vexemu_init(void)
+{
+	u32 eax, ebx, ecx, edx;
+	struct fpu *f = task_fpu(current);
+
+	if (!boot_cpu_has(X86_FEATURE_AVX) || !boot_cpu_has(X86_FEATURE_XSAVE)) {
+		pr_err("gbos_vexemu: needs AVX and XSAVE\n");
+		return -ENODEV;
+	}
+	cpuid_count(0xd, 2, &eax, &ebx, &ecx, &edx);
+	if (ebx != YMMH_OFF || eax != 256) {
+		pr_err("gbos_vexemu: unexpected YMM state layout (off %u size %u)\n", ebx, eax);
+		return -ENODEV;
+	}
+	/* sanity-check the task_struct+fpu layout assumption on a live task before trusting it in a trap */
+	if (!f->fpstate || f->fpstate != &f->__fpstate) {
+		pr_err("gbos_vexemu: fpu layout check failed (fpstate %px vs %px)\n", f->fpstate, &f->__fpstate);
+		return -ENODEV;
+	}
+	churro_aes_init();
+	if (register_die_notifier(&nb))
+		return -EBUSY;
+	pr_info("gbos_vexemu: loaded (GFNI/VAES/VPCLMULQDQ/AVX-VNNI/AVX-IFMA/SHA-NI on #UD)\n");
+	return 0;
+}
+
+static void __exit vexemu_exit(void)
+{
+	unregister_die_notifier(&nb);
+	pr_info("gbos_vexemu: unloaded\n");
+}
+/* built in: level 3, i.e. before every device/rootfs initcall and long before the first user process */
+arch_initcall(vexemu_init);
+module_exit(vexemu_exit);
