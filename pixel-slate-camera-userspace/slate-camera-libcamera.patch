+ * negotiation and function selection can treat it as ordinary Bayer. Any
+ * other format is returned unchanged.
+ */
+static PixelFormat ipu3UnpackedFormat(const PixelFormat &format)
+{
+	const BayerFormat bayer = BayerFormat::fromPixelFormat(format);
+
+	if (bayer.packing != BayerFormat::Packing::IPU3)
+		return format;
+
+	return BayerFormat(bayer.order, bayer.bitDepth,
+			   BayerFormat::Packing::None)
