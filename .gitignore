# Kernel source (downloaded by scripts, not tracked)
builds/linux-*/

# Build artifacts
*.o
*.ko
*.ko.zst
*.mod
*.a
vmlinux*
bzImage
System.map
Module.symvers
*.order
.tmp_versions/

# Build / install / debug / rebuild logs (anywhere)
*.log

# Claude Code workspace state (per-user)
.claude/

# Local clones of external sources managed by build scripts
external/

# Timestamped kernel config snapshots saved during builds
configs/.config-*


# Generated installers (distribute via GitHub Releases)
*-installer.sh
installer-*/

# Temporary files
*.tmp
*.swp
*~
/tmp/

# Editor files
.vscode/
.idea/
*.sublime-*

# OS files
.DS_Store
Thumbs.db
*-installer.tar.gz

# Installer tarballs (too large for git)
*.tar.gz
releases/*.tar.gz

# Build artifacts
boot/
lib/modules/
VERSION
install.sh
uninstall.sh
installer-*/

tests/

# Patch tool backup files
*.patch.old
*.patch.orig
*.rej
